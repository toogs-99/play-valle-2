DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/DBNAME?schema=public"
REDIS_URL="redis://HOST:6379"

# Gere com: openssl rand -base64 32
AUTH_SECRET="CHANGE_ME"
AUTH_URL="http://localhost:3001"

# Chave de criptografia dos tokens de integração (ex: Instagram Graph API) salvos
# no banco. OBRIGATÓRIO gerar uma chave nova e única antes de ir para produção —
# nunca reutilize a chave de exemplo/dev. Gere com: openssl rand -base64 32
CRYPTO_SECRET_KEY="CHANGE_ME"

# Segredo para autenticar chamadas ao endpoint de cron externo
# (POST /api/cron/sync-instagram). Configure o mesmo valor no serviço de cron
# (ex: cron job da hospedagem, GitHub Actions, etc.) como header
# "Authorization: Bearer <valor>". Gere com: openssl rand -base64 32
CRON_SECRET="CHANGE_ME"
